# Copy this file to .env and adjust. .env is ignored by git.
#
#   cp .env.example .env
#
# Everything named VITE_ is baked into the built JavaScript and readable by
# anyone using the site, so never put a secret in here.

# Where the Spring Boot API is reachable, including the /api context path.
VITE_API_BASE_URL=http://localhost:60200/api

# Routing service used to draw the route to a report. The public OSRM demo
# server is the default and is rate limited; point this at your own instance
# for anything beyond testing.
VITE_OSRM_URL=https://router.project-osrm.org
